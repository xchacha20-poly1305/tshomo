{
  "name": "tshomo",
  "version": "0.0.2",
  "description": "Framework-independent Clash-compatible API client",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions/refind": {
      "types": "./dist/extensions/refind.d.ts",
      "import": "./dist/extensions/refind.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:browser": "bun run build && playwright test",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build",
    "test:package": "bun run build && node scripts/test-package.mjs",
    "format": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
